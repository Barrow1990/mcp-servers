# Copy to .env and fill in real values.
#
# One file for the whole stack, but no container gets more than its own
# variables — docker-compose.yml lists each service's variables explicitly
# under its own `environment:` block (Compose ${VAR} substitution), instead
# of `env_file:` (which would dump this entire file into every container
# regardless of what that service actually needs). Grouped by service below
# purely for readability; the names themselves are what matters.

# --- sonarr-mcp ---
SONARR_URL=http://192.168.1.50:8989
SONARR_API_KEY=replace-with-your-sonarr-api-key
SONARR_MCP_AUTH_TOKEN=

# --- radarr-mcp ---
RADARR_URL=http://192.168.1.50:7878
RADARR_API_KEY=replace-with-your-radarr-api-key
RADARR_MCP_AUTH_TOKEN=

# --- bazarr-mcp ---
BAZARR_URL=http://192.168.1.50:6767
BAZARR_API_KEY=replace-with-your-bazarr-api-key
BAZARR_MCP_AUTH_TOKEN=

# --- prowlarr-mcp ---
PROWLARR_URL=http://192.168.1.50:9696
PROWLARR_API_KEY=replace-with-your-prowlarr-api-key
PROWLARR_MCP_AUTH_TOKEN=

# --- authentik-mcp ---
# Authentik > Directory > Tokens and App passwords > Create (Intent: API
# Token), against a dedicated service account — see authentik-mcp-server's
# own README for RBAC scoping guidance before granting more than read access.
AUTHENTIK_URL=http://192.168.1.50:9000
AUTHENTIK_API_TOKEN=replace-with-your-authentik-api-token
# Master switch for the one write tool (set_user_active). Off by default —
# even set to true, each call still needs confirm=True too.
AUTHENTIK_ALLOW_WRITES=false
# Given what this server can reach, treat this one as non-optional.
AUTHENTIK_MCP_AUTH_TOKEN=

# --- streamystats-mcp ---
# Base URL of the Streamystats web app itself (not Jellyfin).
STREAMYSTATS_URL=http://192.168.1.50:3000
# A Jellyfin API key — Streamystats has no API key of its own for external
# clients, it validates this directly against Jellyfin.
STREAMYSTATS_JELLYFIN_TOKEN=replace-with-a-jellyfin-api-key
STREAMYSTATS_MCP_AUTH_TOKEN=

# --- reclaimerr-mcp ---
# Reclaimerr > Settings > Account > API Tokens > Create Token
RECLAIMERR_URL=http://192.168.1.50:8000
RECLAIMERR_API_TOKEN=replace-with-your-reclaimerr-api-token
RECLAIMERR_MCP_AUTH_TOKEN=

# --- tracearr-mcp ---
# Tracearr > Settings > General > API key (trr_pub_...). Needs Tracearr 2.0+
# and an owner-account key. Exposes every user's watch history and email
# address, so treat the auth token below as non-optional.
TRACEARR_URL=http://192.168.1.50:3000
TRACEARR_API_KEY=replace-with-your-tracearr-api-key
TRACEARR_MCP_AUTH_TOKEN=

# --- dockhand-mcp (third-party: strausmann/mcp-dockhand) ---
# Authenticates with a Dockhand username/password, not an API token.
DOCKHAND_URL=http://192.168.1.50:PORT
DOCKHAND_USERNAME=replace-with-your-dockhand-username
DOCKHAND_PASSWORD=replace-with-your-dockhand-password
DOCKHAND_MCP_AUTH_TOKEN=
DOCKHAND_MCP_ALLOWED_HOSTS=
DOCKHAND_MCP_ALLOWED_ORIGINS=

# --- jellyfin-mcp (third-party: jaredtrent/jellyfin-mcp) ---
JELLYFIN_URL=http://192.168.1.50:8096
JELLYFIN_API_KEY=replace-with-your-jellyfin-api-key
# Optional — omit to let jellyfin-mcp auto-detect the user context.
JELLYFIN_USER_ID=
# Required once bound to 0.0.0.0 (which this compose does, to be
# LAN-reachable) — passed as a --http-token CLI flag, confirmed from the
# upstream project's own docker-compose.yml.
JELLYFIN_HTTP_TOKEN=replace-with-a-random-secret-openssl-rand-hex-32

# --- lubelogger-mcp (third-party, official: hargata/lubelog_mcp) ---
# Only LUBELOG_INSTANCE lives here. Confirmed from this project's own
# source (LubeLoggerMCP.cs's AddAuthHeaders): there is no server-side API
# key variable at all — per request, it forwards whatever Authorization or
# x-api-key header (or ?apiKey= query param) the CALLING MCP CLIENT sent,
# falling back to LUBELOG_USER/LUBELOG_PASS (Basic auth, full account) only
# if neither is set here AND the client supplied nothing.
#
# Recommended: generate a Viewer-scoped API key in LubeLogger's own UI
# (Settings > API keys — supports Viewer/Editor/Manager scopes) and put it
# in your MCP CLIENT's connection config instead (e.g. `claude mcp add
# lubelogger --transport http "http://<host>:8938/api/mcp?apiKey=<key>"`,
# or an `--header "x-api-key: <key>"` flag) — NOT here.
#
# Leave LUBELOG_USER/LUBELOG_PASS unset (as below) so that's the ONLY way
# in. Setting them here as a "fallback" means anyone who reaches this port
# without supplying their own key rides on full-account Basic auth for
# free — there's no bearer-token gate of its own on this server the way
# there is on the custom-built ones in this stack.
LUBELOG_INSTANCE=http://192.168.1.50:8080
LUBELOG_USER=
LUBELOG_PASS=

# --- seerr-mcp (third-party: jhomen368/overseerr-mcp) ---
# Works against seerr-team/seerr, Jellyseerr, or Overseerr — same API.
SEERR_URL=http://192.168.1.50:5055
SEERR_API_KEY=replace-with-your-seerr-api-key
