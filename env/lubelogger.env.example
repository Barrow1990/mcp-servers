# Copy to lubelogger.env (this directory) and fill in your values.
# hargata/lubelog_mcp (third-party, built by LubeLogger's own author — see
# README). This is "Local Auth" mode per its own docker-compose.yml; it also
# supports a "Header Auth" mode with different, narrower-scoped variables —
# we could not fetch the exact variable names for that mode from its wiki
# (the page didn't load via automated fetch), so if you want header-based
# auth instead of full local-auth access, check
# https://github.com/hargata/lubelog_mcp/wiki/Header-Auth directly first.
LUBELOG_INSTANCE=http://192.168.1.50:8080
LUBELOG_USER=replace-with-your-lubelogger-username
LUBELOG_PASS=replace-with-your-lubelogger-password
