# Copy to jellyfin.env (this directory) and fill in your values.
# jaredtrent/jellyfin-mcp (third-party — see README).
#
# IMPORTANT: unlike every other file in this env/ directory, this one does
# NOT carry the bearer token — JELLYFIN_HTTP_TOKEN goes in the root .env
# instead (see .env.example at this repo's root), because the jellyfin-mcp
# service passes it as a `command:` argument, which docker-compose can only
# substitute from its own root .env, not from an env_file. Don't be
# surprised it's not set here; that's deliberate, not a mistake.
JELLYFIN_URL=http://192.168.1.50:8096
JELLYFIN_API_KEY=replace-with-your-jellyfin-api-key
# Optional — omit to let jellyfin-mcp auto-detect the user context.
JELLYFIN_USER_ID=
