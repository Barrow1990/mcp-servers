# Copy to bazarr.env (this directory) and fill in your values.
# Bazarr > Settings > General > Security > API Key
BAZARR_URL=http://192.168.1.50:6767
BAZARR_API_KEY=replace-with-your-bazarr-api-key

# Shared secret required as `Authorization: Bearer <token>` on every request
# to this server. Leave unset to run with no auth. openssl rand -hex 32
MCP_AUTH_TOKEN=
