# Copy to authentik.env (this directory) and fill in your values.
# Authentik > Directory > Tokens and App passwords > Create (Intent: API
# Token), against a dedicated service account — do not reuse your own admin
# user. See authentik-mcp-server's own README for RBAC scoping guidance.
AUTHENTIK_URL=http://192.168.1.50:9000
AUTHENTIK_API_TOKEN=replace-with-your-authentik-api-token

# Master switch for the one write tool (set_user_active). Off by default —
# even set to true, each call still needs confirm=True too.
AUTHENTIK_ALLOW_WRITES=false

# Shared secret required as `Authorization: Bearer <token>` on every request
# to this server. Given what this server can reach (every user account in
# your identity provider), treat this one as non-optional. openssl rand -hex 32
MCP_AUTH_TOKEN=
