# Copy to prowlarr.env (this directory) and fill in your values.
# Prowlarr > Settings > General > API Key
PROWLARR_URL=http://192.168.1.50:9696
PROWLARR_API_KEY=replace-with-your-prowlarr-api-key

# Shared secret required as `Authorization: Bearer <token>` on every request
# to this server. Leave unset to run with no auth. openssl rand -hex 32
MCP_AUTH_TOKEN=
