# Copy to reclaimerr.env (this directory) and fill in your values.
# Reclaimerr > Settings > Account > API Tokens > Create Token
# Needs scopes: candidates:read, protections:read, system:read (read-only
# tools), plus candidates:manage, tasks:read, tasks:run (write tools).
RECLAIMERR_URL=http://192.168.1.50:8000
RECLAIMERR_API_TOKEN=replace-with-your-reclaimerr-api-token

# Shared secret required as `Authorization: Bearer <token>` on every request
# to this server. Leave unset to run with no auth. openssl rand -hex 32
MCP_AUTH_TOKEN=
