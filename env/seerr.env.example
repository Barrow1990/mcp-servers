# Copy to seerr.env (this directory) and fill in your values.
# jhomen368/overseerr-mcp (third-party — see README). Works against
# seerr-team/seerr, Jellyseerr, or Overseerr — same API across all three.
# Seerr/Jellyseerr/Overseerr > Settings > General > API Key
SEERR_URL=http://192.168.1.50:5055
SEERR_API_KEY=replace-with-your-seerr-api-key
