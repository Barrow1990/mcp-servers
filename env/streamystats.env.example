# Copy to streamystats.env (this directory) and fill in your values.
# Base URL of your Streamystats web app (not Jellyfin itself).
STREAMYSTATS_URL=http://192.168.1.50:3000

# A Jellyfin API key or user access token — Streamystats has no API key of
# its own for external clients, it validates this directly against Jellyfin.
STREAMYSTATS_JELLYFIN_TOKEN=replace-with-a-jellyfin-api-key

# Shared secret required as `Authorization: Bearer <token>` on every request
# to this server. Leave unset to run with no auth. openssl rand -hex 32
MCP_AUTH_TOKEN=
