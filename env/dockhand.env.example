# Copy to dockhand.env (this directory) and fill in your values.
# strausmann/mcp-dockhand (third-party — see README) authenticates with a
# Dockhand username/password, NOT an API token like the *arr-family servers
# in this stack. Confirmed from https://github.com/strausmann/mcp-dockhand.
DOCKHAND_URL=http://192.168.1.50:PORT
DOCKHAND_USERNAME=replace-with-your-dockhand-username
DOCKHAND_PASSWORD=replace-with-your-dockhand-password

# Optional extra layers this project supports on top of Dockhand auth itself
# (see its README for details) — leave blank to skip.
MCP_AUTH_TOKEN=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
